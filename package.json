{
  "name": "classical-recording-studio",
  "productName": "Classical Recording Studio",
  "version": "0.2.20",
  "description": "Local classical concert recording editor and album production workbench",
  "author": "Classical Recording Studio contributors",
  "license": "MIT",
  "type": "module",
  "main": "desktop/bootstrap.mjs",
  "scripts": {
    "build": "node scripts/build.mjs --desktop",
    "start": "npm run build && electron .",
    "test": "node --test",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac zip --arm64 --x64 --publish never"
  },
  "dependencies": {
    "heic-convert": "2.1.0",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.0.0"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "fflate": "0.8.2",
    "pdfjs-dist": "5.4.624"
  },
  "build": {
    "appId": "org.classicalrecording.studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "dist/server/**",
      "drizzle/**",
      "web/seed.js",
      "web/script.js",
      "web/audio-effects.js",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Classical-Recording-Studio-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Classical-Recording-Studio-${version}-Portable-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/libheif-js/**"
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "category": "public.app-category.music",
      "artifactName": "Classical-Recording-Studio-v${version}-macOS-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
